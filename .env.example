# Vorlage für die Zugangsdaten. Kopieren nach ".env" und ausfüllen.
# Die Datei .env wird NICHT ins Git-Repository übernommen.

# E-Mail-Versand nach dem Training (smtp2go)
SMTP_SERVER=mail.smtp2go.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=x-ski@parmeltec.org

# Strava-Upload (Utils/strava_upload.py)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional: Konfigurationsänderungen auch von anderen Geräten im Netz erlauben (1 = ja)
# X_SKI_ALLOW_REMOTE_CONFIG=0
