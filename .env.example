# Vorlage für die Zugangsdaten. Kopieren nach ".env" und ausfüllen.
# Die Datei .env wird NICHT ins Git-Repository übernommen.

# E-Mail-Versand nach dem Training (smtp2go)
SMTP_SERVER=mail.smtp2go.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=x-ski@parmeltec.org

# Strava-App dieser Installation (https://www.strava.com/settings/api); die Konten verbinden sich pro Profil
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional: Konfigurationsänderungen auch von anderen Geräten im Netz erlauben (1 = ja)
# X_SKI_ALLOW_REMOTE_CONFIG=0

# Tracking-Chat (gps-live): Meldungen «Training gestartet/beendet» in der Streckensimulation.
# TRACKING_SK ist der Secret-Link des Geräts (https://tracking.gps-live.ch/s/<TRACKING_SK>).
TRACKING_DEVICE_ID=
TRACKING_SK=
# TRACKING_CHAT_URL=https://tracking.gps-live.ch/api/chat_send/actualPosition
# TRACKING_MEDIA_URL=https://tracking.gps-live.ch/api/chat_send_media/actualPosition
