warmup:
  type: duration_block
  duration: 890
  intensity_start: 70
  intensity_end: 70

transition_to_main:
  type: transition
  duration: 10
  curve: ease

main_set:
  type: interval_block
  block_amount: 6
  on_duration: 230
  on_intensity: 160
  off_duration: 170
  off_intensity: 70
  transition:
    type: ease
    duration: 10

cooldown_transition:
  type: transition
  duration: 10
  curve: ease

cooldown:
  type: duration_block
  duration: 890
  intensity_start: 70
  intensity_end: 70